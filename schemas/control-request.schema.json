{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ControlRequest",
  "type": "object",
  "properties": {
    "auth": {
      "anyOf": [
        {
          "$ref": "#/$defs/LiveAuth"
        },
        {
          "type": "null"
        }
      ]
    },
    "command": {
      "$ref": "#/$defs/Command"
    },
    "execution_mode": {
      "$ref": "#/$defs/ExecutionMode"
    },
    "profile": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "request_id",
    "profile",
    "execution_mode",
    "command"
  ],
  "$defs": {
    "Command": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "session_status"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "session_logout"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "ord_type": {
              "$ref": "#/$defs/OrderType"
            },
            "price": {
              "type": [
                "string",
                "null"
              ]
            },
            "quantity": {
              "type": "string"
            },
            "side": {
              "$ref": "#/$defs/Side"
            },
            "symbol": {
              "type": "string"
            },
            "time_in_force": {
              "$ref": "#/$defs/TimeInForce"
            },
            "type": {
              "type": "string",
              "const": "new_order_single"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "symbol",
            "side",
            "quantity",
            "ord_type",
            "time_in_force"
          ]
        },
        {
          "type": "object",
          "properties": {
            "original_request_id": {
              "type": "string"
            },
            "side": {
              "$ref": "#/$defs/Side"
            },
            "symbol": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "cancel_order"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "original_request_id",
            "symbol",
            "side"
          ]
        },
        {
          "type": "object",
          "properties": {
            "ord_type": {
              "$ref": "#/$defs/OrderType"
            },
            "original_request_id": {
              "type": "string"
            },
            "price": {
              "type": [
                "string",
                "null"
              ]
            },
            "quantity": {
              "type": "string"
            },
            "side": {
              "$ref": "#/$defs/Side"
            },
            "symbol": {
              "type": "string"
            },
            "time_in_force": {
              "$ref": "#/$defs/TimeInForce"
            },
            "type": {
              "type": "string",
              "const": "replace_order"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "original_request_id",
            "symbol",
            "side",
            "quantity",
            "ord_type",
            "time_in_force"
          ]
        }
      ]
    },
    "ExecutionMode": {
      "type": "string",
      "enum": [
        "inspect",
        "dry_run",
        "certification",
        "live"
      ]
    },
    "LiveAuth": {
      "type": "object",
      "properties": {
        "key_id": {
          "type": "string"
        },
        "mac_hex": {
          "type": "string"
        },
        "nonce": {
          "type": "string"
        },
        "unix_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "key_id",
        "unix_ms",
        "nonce",
        "mac_hex"
      ]
    },
    "OrderType": {
      "type": "string",
      "enum": [
        "market",
        "limit"
      ]
    },
    "Side": {
      "type": "string",
      "enum": [
        "buy",
        "sell"
      ]
    },
    "TimeInForce": {
      "type": "string",
      "enum": [
        "day",
        "gtc",
        "ioc",
        "fok"
      ]
    }
  }
}